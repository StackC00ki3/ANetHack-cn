<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent so the map stays readable behind the pad; the border keeps the keys legible. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/touch_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/direction_pad_item" />
            <stroke android:width="1dp" android:color="@color/direction_pad_item_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
