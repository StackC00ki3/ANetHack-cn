<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ANetHack" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surface colors used by Material dialogs and custom popup views. -->
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_on_surface</item>
        <!-- System bars and window background. -->
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


</resources>
