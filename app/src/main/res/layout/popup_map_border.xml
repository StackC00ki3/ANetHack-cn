<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_border_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/ui_on_surface" />

        <TextView
            android:id="@+id/map_border_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:text="@string/map_border_reset"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/touch_bar_edit_accent" />
    </LinearLayout>

    <com.yywspace.anethack.setting.MapBorderPreviewView
        android:id="@+id/map_border_preview"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:background="@color/map_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_border_width"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ui_on_surface" />

        <TextView
            android:id="@+id/map_border_width_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ui_on_surface_secondary" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/map_border_width_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_border_opacity"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ui_on_surface" />

        <TextView
            android:id="@+id/map_border_opacity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ui_on_surface_secondary" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/map_border_opacity_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/map_border_color"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/ui_on_surface" />

    <LinearLayout
        android:id="@+id/map_border_swatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />
</LinearLayout>
